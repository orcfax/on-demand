PUBLIC_NODE_ENV=development                # development, test, or production
PUBLIC_CHANNEL_INIT_COST=1000
PUBLIC_MAINNET_ENABLED=false

# Blockfrost (Cardano data provider)
PUBLIC_BLOCKFROST_NETWORK=Preview          # Preview or Mainnet
PRIVATE_BLOCKFROST_API_KEY=                # Blockfrost API key matching the network above

# ODAPI / Subbit backend
PRIVATE_ODAPI_VALIDATOR_URL=               # Orcfax validator node endpoint
PRIVATE_SUBBIT_MAN_URL=http://localhost:7822

# Provider identity
PUBLIC_PROVIDER_KEY_HASH=

# Umami Analytics (production only)
PUBLIC_UMAMI_URL=                           # Umami instance URL (e.g. https://umami.example.com)
PUBLIC_UMAMI_WEBSITE_ID=                    # Website ID from Umami dashboard
