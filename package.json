{
	"name": "on-demand",
	"description": "A web application for Orcfax On-Demand, an on-demand and permissionless blockchain oracle service.",
	"version": "0.0.1",
	"author": "Orcfax Ltd.",
	"type": "module",
	"scripts": {
		"dev": "concurrently -k -n web,subbit -c blue,magenta \"vite dev\" \"pnpm -C services/subbit-man-js start\"",
		"dev:only:web": "vite dev",
		"build": "vite build",
		"start": "node build",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"preview": "concurrently -k -n web,subbit -c blue,magenta \"vite preview\" \"pnpm -C services/subbit-man-js start\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"postinstall": "svelte-kit sync && node scripts/fix-libsodium.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.10.1",
		"@lucide/svelte": "^0.561.0",
		"@rollup/plugin-commonjs": "^29.0.0",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/vite": "^4.1.14",
		"@tanstack/table-core": "^8.21.3",
		"autoprefixer": "^10.4.20",
		"bits-ui": "^2.14.4",
		"buffer": "^6.0.3",
		"clsx": "^2.1.1",
		"concurrently": "^9.1.2",
		"crypto-browserify": "^3.12.1",
		"esbuild": "^0.21.0",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"events": "^3.3.0",
		"globals": "^17.4.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"process": "^0.11.10",
		"publint": "^0.2.0",
		"stream-browserify": "^3.0.0",
		"string_decoder": "^1.3.0",
		"svelte": "^5.46.0",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.14",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.57.1",
		"vite": "^5.0.3",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-plugin-node-polyfills": "^0.22.0",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@harmoniclabs/crypto": "^0.3.0",
		"@meshsdk/common": "1.9.0-beta.90",
		"@meshsdk/core": "1.9.0-beta.90",
		"@meshsdk/svelte": "1.9.0-beta.90",
		"@noble/ed25519": "^2.2.3",
		"@noble/hashes": "^1.8.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"cbor2": "^2.0.1",
		"tabel-core": "link:@types/@tanstack/tabel-core",
		"zod": "^4.1.12"
	}
}
